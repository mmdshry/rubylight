# LiteSpeed / Apache — SPA + gold-price proxy
# Copy lands in dist/ via Vite publicDir
# Use when the web root is the contents of dist/

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  <FilesMatch "(index\.html|sw\.js|workbox-.*\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  RequestHeader set Referer "https://www.tala.ir/" env=TALA
  RequestHeader set X-Requested-With "XMLHttpRequest" env=TALA
  RequestHeader set Accept "application/json, text/javascript, */*; q=0.01" env=TALA
  RequestHeader set Cookie "_trc=1" env=TALA
  RequestHeader set User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36" env=TALA
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /api/tala → local Node proxy (optional PM2 on :3009)
  RewriteRule ^api/tala/?$ http://127.0.0.1:3009/api/tala [P,L]

  # Existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# If [P] to HTTPS fails, in LiteSpeed WebAdmin:
#   External App → https://www.tala.ir
#   Context /api/tala → that app, URI /banner
#   Request headers: Referer https://www.tala.ir/
#                    X-Requested-With XMLHttpRequest
#                    Accept application/json, text/javascript, */*; q=0.01
#                    Cookie _trc=1
