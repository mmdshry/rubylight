# public_html/.htaccess — LiteSpeed
# Layout:
#   public_html/
#     .htaccess          (this file — reverse proxy to PM2)
#     rubylight/         (full project; PM2 runs from here)
#
# PM2 must be running: Rubylight on 127.0.0.1:3009
#   cd /home/rubylight/public_html/rubylight
#   pm2 start ecosystem.config.cjs

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy all traffic to the Node app on port 3009
  RewriteRule ^(.*)$ http://127.0.0.1:3009/$1 [P,L]
</IfModule>

# If [P] proxy returns 500/404, create in LiteSpeed WebAdmin:
#   External App → http://127.0.0.1:3009
#   Context / → that app (URI /)
