# public_html/.htaccess — LiteSpeed
# Layout:
#   public_html/
#     .htaccess          (this file)
#     rubylight/dist/    (Vite build — site is served from here)
#
# Do NOT proxy / to 127.0.0.1:3009. That returns 503 when Node/PM2 is down.
# Copy: cp deploy/public_html.htaccess /home/rubylight/public_html/.htaccess
#
# If LiteSpeed WebAdmin has Context / → External App :3009, delete that
# Context or the homepage will keep returning 503.

Options -Indexes
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  RequestHeader set Referer "https://www.tala.ir/" env=TALA
  RequestHeader set X-Requested-With "XMLHttpRequest" env=TALA
  RequestHeader set Accept "application/json, text/javascript, */*; q=0.01" env=TALA
  RequestHeader set Cookie "_trc=1" env=TALA
  RequestHeader set User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36" env=TALA
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Already under /rubylight/dist — serve as-is
  RewriteRule ^rubylight/dist(/|$) - [L]

  # /api/tala → local Node proxy (PM2 on :3009). Site stays up if this fails.
  RewriteRule ^api/tala/?$ http://127.0.0.1:3009/api/tala [P,L]

  # Built asset in dist
  RewriteCond %{DOCUMENT_ROOT}/rubylight/dist/$1 -f
  RewriteRule ^(.+)$ /rubylight/dist/$1 [L]

  # SPA: homepage and client routes → dist/index.html
  RewriteCond %{DOCUMENT_ROOT}/rubylight/dist/index.html -f
  RewriteRule ^ /rubylight/dist/index.html [L]
</IfModule>

# If [P] to tala.ir fails, in LiteSpeed WebAdmin:
#   External App → https://www.tala.ir
#   Context /api/tala → that app, URI /banner
#   Do not point Context / at 127.0.0.1:3009
