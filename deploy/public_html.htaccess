# public_html/.htaccess — LiteSpeed
# Layout A — web root is dist/ contents:
#   public_html/
#     .htaccess
#     index.html, assets/, ...
#
# Layout B — repo stays in a subfolder:
#   public_html/
#     .htaccess          (this file)
#     rubylight/dist/    (Vite build output)
#
# No PM2. Only /api/tala is proxied (to tala.ir).

<IfModule mod_headers.c>
  RequestHeader set Referer "https://www.tala.ir/" env=TALA
  RequestHeader set X-Requested-With "XMLHttpRequest" env=TALA
  RequestHeader set Accept "application/json, text/javascript, */*; q=0.01" env=TALA
  RequestHeader set Cookie "_trc=1" env=TALA
  RequestHeader set User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36" env=TALA
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /api/tala → tala.ir (no Node / PM2)
  RewriteRule ^api/tala/?$ https://www.tala.ir/banner [P,L,E=TALA:1]

  # Layout B: serve built files from rubylight/dist when present
  RewriteCond %{DOCUMENT_ROOT}/rubylight/dist/%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /rubylight/dist/$1 [L]

  RewriteCond %{DOCUMENT_ROOT}/rubylight/dist/%{REQUEST_URI} -d
  RewriteRule ^(.*)$ /rubylight/dist/$1 [L]

  # Layout A: existing files in the web root
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback — prefer rubylight/dist, else web-root index.html
  RewriteCond %{DOCUMENT_ROOT}/rubylight/dist/index.html -f
  RewriteRule ^ /rubylight/dist/index.html [L]

  RewriteRule ^ index.html [L]
</IfModule>

# If [P] to HTTPS fails, in LiteSpeed WebAdmin:
#   External App → https://www.tala.ir
#   Context /api/tala → that app, URI /banner
#   Request headers: Referer https://www.tala.ir/
#                    X-Requested-With XMLHttpRequest
#                    Accept application/json, text/javascript, */*; q=0.01
#                    Cookie _trc=1
